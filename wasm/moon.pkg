import {
  "moonviz/core",
  "moonviz/decl",
}

options(
  link: {
    // classic wasm：标准 WASM MVP（无 js-string/GC 提案依赖），跨平台
    // 宿主中立——任何规范运行时可实例化。字符串 ABI 为线性内存对象
    // （[4B refcnt][4B header][len×UTF-16LE]，详见提交 8a893ce 说明）。
    "wasm": {
      "export-memory-name": "memory",
      "exports": [
        "render_mbt",
        "validate_mbt",
        "apply_agent_op",
        "apply_human_op",
        "list_templates",
        "list_components",
        "list_themes",
        "list_tokens",
        "list_ops",
        "export_html",
        "version_info",
      ],
    },
    "wasm-gc": {
      "exports": [
        "render_mbt",
        "validate_mbt",
        "apply_agent_op",
        "apply_human_op",
        "list_templates",
        "list_components",
        "list_themes",
        "list_tokens",
        "list_ops",
        "export_html",
        "version_info",
      ],
      "use-js-builtin-string": true,
    },
  },
)
