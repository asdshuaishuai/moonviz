import {
  "moonviz/core",
  "moonviz/decl",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/ref",
}

options(
  link: {
    // classic wasm：标准 WASM MVP（无 js-string/GC 提案依赖），跨平台
    // 宿主中立——任何规范运行时可实例化。字符串 ABI 为线性内存对象
    // （[4B refcnt][4B header][len×UTF-16LE]，详见提交 8a893ce 说明）。
    "wasm": {
      "export-memory-name": "memory",
      "exports": [
        "render_mbt",
        "validate_mbt",
        "apply_agent_op",
        "apply_human_op",
        "list_templates",
        "list_components",
        "list_themes",
        "list_tokens",
        "list_ops",
        "export_html",
        "version_info",
        "session_apply_agent",
        "session_apply_human",
        "session_auto_fix",
        "session_benchmark",
        "session_close",
        "session_component_compile_b64",
        "session_constrain",
        "session_critique",
        "session_export_svg",
        "session_extract_design_system",
        "session_flows",
        "session_generate_responsive",
        "session_infer_missing",
        "session_infer_page_type",
        "session_interactions",
        "session_library_snapshot",
        "session_lint",
        "session_list_artboards",
        "session_open",
        "session_query_nodes",
        "session_save",
        "session_spec",
        "session_states",
        "session_tap",
      ],
    },
    "wasm-gc": {
      "exports": [
        "render_mbt",
        "validate_mbt",
        "apply_agent_op",
        "apply_human_op",
        "list_templates",
        "list_components",
        "list_themes",
        "list_tokens",
        "list_ops",
        "export_html",
        "version_info",
        "session_apply_agent",
        "session_apply_human",
        "session_auto_fix",
        "session_benchmark",
        "session_close",
        "session_component_compile_b64",
        "session_constrain",
        "session_critique",
        "session_export_svg",
        "session_extract_design_system",
        "session_flows",
        "session_generate_responsive",
        "session_infer_missing",
        "session_infer_page_type",
        "session_interactions",
        "session_library_snapshot",
        "session_lint",
        "session_list_artboards",
        "session_open",
        "session_query_nodes",
        "session_save",
        "session_spec",
        "session_states",
        "session_tap",
      ],
      "use-js-builtin-string": true,
    },
  },
)
